# =============================================================================
# next-app-bookclub 環境変数テンプレート
#
# 使い方:
#   1. このファイルを `.env` にコピー: `cp .env.example .env`
#   2. 必須項目 (# Required と書かれた行) を埋める
#   3. 機能を有効化する任意項目があればまとめてセットする (片欠け禁止)
#
# Source of Truth:
#   - 検証スキーマ: `src/lib/config/env.ts` (Zod)
#   - ローカル手順: `docs/usages/local-setup.md`
#
# Note:
#   - .env はリポジトリにコミットしない (`.gitignore` で除外済)
#   - secret 系は本番で必ず再生成する
# =============================================================================

# -----------------------------------------------------------------------------
# Node.js 環境
# -----------------------------------------------------------------------------
NODE_ENV="development"

# -----------------------------------------------------------------------------
# ログレベル (Optional)
# -----------------------------------------------------------------------------
# Optional — サーバーログの詳細度。開発時は "debug" 推奨。
# 値: fatal | error | warn | info | debug | trace
LOG_LEVEL="info"

# -----------------------------------------------------------------------------
# Database (Prisma)
# -----------------------------------------------------------------------------
# Required
# PostgreSQL 接続文字列。`docker compose up -d` でローカル DB を起動してから設定する。
# 形式: postgresql://user:password@host:port/dbname?schema=public
DATABASE_URL=postgresql://app:app@localhost:54322/app?schema=public

# -----------------------------------------------------------------------------
# NextAuth.js 認証
# -----------------------------------------------------------------------------
# Required
# セッション暗号化キー。32 文字以上必須。
# 生成: openssl rand -base64 48
NEXTAUTH_SECRET=""
# Required
# アプリの公開 URL (開発: http://localhost:3000)
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Google OAuth (Optional)
# GOOGLE_CLIENT_ID と GOOGLE_CLIENT_SECRET は両方セットするか、両方未設定にすること。
# 片方だけ設定すると起動時に "Google OAuth keys must be all-set or all-unset" で失敗する。
# 取得: https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# GitHub OAuth (Optional)
# GITHUB_CLIENT_ID と GITHUB_CLIENT_SECRET は両方セットするか、両方未設定にすること。
# 片方だけ設定すると起動時に "GitHub OAuth keys must be all-set or all-unset" で失敗する。
# 取得: https://github.com/settings/developers
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# SMTP メール送信 (Optional)
# SMTP_HOST / SMTP_USER / SMTP_PASSWORD は 3 つすべてセットするか、すべて未設定にすること。
# Gmail: smtp.gmail.com (ポート 587) / Outlook: smtp-mail.outlook.com (ポート 587)
# -----------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Optional — 送信元メールアドレス (例: noreply@example.com)
SMTP_FROM_EMAIL=""
# Optional — 送信元表示名 (例: BookClub)
SMTP_FROM_NAME=""

# -----------------------------------------------------------------------------
# Google Books API (Optional)
# -----------------------------------------------------------------------------
# Optional — 書籍検索 API キー。未設定時は ~100 req/日 のレート制限がかかる。
# 取得: https://console.cloud.google.com/ → プロジェクト作成 → Books API 有効化 → 認証情報でキー作成
GOOGLE_BOOKS_API_KEY=""

# -----------------------------------------------------------------------------
# メンテナンスモード (Optional)
# -----------------------------------------------------------------------------
# Optional — "true" にするとメンテナンスページを表示する。
MAINTENANCE_MODE=""
# Optional — 管理者アクセスを許可する IP アドレス (カンマ区切り)。例: 192.168.1.1,10.0.0.1
ADMIN_ALLOWED_IPS=""

# -----------------------------------------------------------------------------
# Cron ジョブ認証
# -----------------------------------------------------------------------------
# Optional (本番では Required) — Cron API エンドポイントの認証シークレット。32 文字以上。
# 生成: openssl rand -base64 48
CRON_SECRET=""

# -----------------------------------------------------------------------------
# 画像ストレージ: Cloudflare R2 (本番) / MinIO (ローカル開発)
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_BUCKET_NAME / R2_ENDPOINT の
# 4 つがすべてセットされている場合に R2/MinIO アップロードが有効になる。
# 未設定時はローカルファイルシステム (public/uploads/) にフォールバックする。
# -----------------------------------------------------------------------------
# Cloudflare R2 (本番) — コメントアウトを外して設定する
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_ENDPOINT=""      # 例: https://<accountid>.r2.cloudflarestorage.com
# R2_PUBLIC_URL=""    # 例: https://cdn.example.com  (カスタムドメインまたは r2.dev URL)

# MinIO (ローカル開発 — docker compose up -d で起動)
R2_ACCESS_KEY_ID="minioadmin"
R2_SECRET_ACCESS_KEY="minioadmin"
R2_BUCKET_NAME="bookclub"
R2_ENDPOINT="http://localhost:9000"
R2_PUBLIC_URL="http://localhost:9000/bookclub"

# -----------------------------------------------------------------------------
# Stripe 決済 (Optional)
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET / STRIPE_BASIC_PRICE_ID / STRIPE_PREMIUM_PRICE_ID の
# 4 つがすべてセットされている場合に Stripe 決済機能が有効になる。
#
# --- ローカル開発 (stripe-mock) ---
# `docker compose up -d` で stripe-mock が localhost:12111 で起動する。
# 以下の値はそのままコピーして使用可能 (実際の Stripe 認証は不要)。
# Webhook テスト: stripe listen --api-base=http://localhost:12111 \
#                               --forward-to localhost:3000/api/stripe/webhook
#
# --- 本番 / テストモード ---
# 取得: https://dashboard.stripe.com/developers
# コメントアウトを外し、本物の値に差し替えること。
# STRIPE_MOCK_HOST と STRIPE_MOCK_PORT は削除または空にすること。
# -----------------------------------------------------------------------------

# ローカル開発用 (stripe-mock)
STRIPE_SECRET_KEY="sk_test_mock_bookclub_local"
STRIPE_WEBHOOK_SECRET="whsec_mock_bookclub_local"
STRIPE_BASIC_PRICE_ID="price_mock_basic_monthly"
STRIPE_PREMIUM_PRICE_ID="price_mock_premium_monthly"
STRIPE_MOCK_HOST="localhost"
STRIPE_MOCK_PORT="12111"

# 本番 / Stripe テストモード (上の行をコメントアウトして以下を設定)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_BASIC_PRICE_ID=""
# STRIPE_PREMIUM_PRICE_ID=""

# -----------------------------------------------------------------------------
# Public 環境変数 (クライアントバンドルに埋め込まれる)
# NEXT_PUBLIC_ プレフィックス付きの値は そのままブラウザに送信される。
# 秘密情報 (API key の write 権限、DB 接続文字列、署名鍵) を絶対に入れないこと。
# -----------------------------------------------------------------------------
# Optional — アプリの公開 URL (OG 画像・sitemap の絶対 URL に使用)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
